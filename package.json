{
  "name": "buck-format",
  "version": "0.1.0",
  "private": true,
  "description": ".buck: a declarative look format for color plus depth-based fog, depth of field and relight, with a local web editor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}